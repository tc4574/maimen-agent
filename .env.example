# Offline demo remains the default for the CLI. The web start script enables live MCP unless -Offline is passed.
MAIMEN_MODE=demo
MAIMEN_DATABASE=data/maimen.sqlite3
# Set privately in .env; python -m maimen.configure provides hidden input.
MCD_MCP_TOKEN=

# Chat model. Put the real key in gitignored .env.deepseek, not in this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# API reads this from the process environment. scripts/start-web.ps1 sets it to 1.
MAIMEN_ENABLE_LIVE_RECOMMENDATIONS=0
